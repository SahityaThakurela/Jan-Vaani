# ============================================================
# Jan Vaani — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env — it is in .gitignore.

# ── App ─────────────────────────────────────────────────────
APP_NAME="Jan Vaani"
APP_VERSION="1.0.0"
ENVIRONMENT=development
APP_SECRET_KEY=your-random-secret-key-here

# ── Database ─────────────────────────────────────────────────
SQLITE_DB_PATH=./janvaani.db

# ── Rime TTS (Coda model) ────────────────────────────────────
RIME_API_KEY=your-rime-api-key-here
RIME_API_URL=https://users.rime.ai/v1/rime-tts
RIME_MODEL=mist
RIME_SPEAKER=maya
RIME_AUDIO_FORMAT=mp3
RIME_SAMPLING_RATE=22050

# ── Google Gemini (LLM reasoning) ────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ── Deepgram (STT — Nova-2) ──────────────────────────────────
DEEPGRAM_API_KEY=your-deepgram-api-key-here
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=hi-IN

# ── Qdrant (Vector DB) ──────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key-if-using-cloud
QDRANT_COLLECTION_SCHEME=scheme_knowledge
QDRANT_COLLECTION_MEMORY=case_memory
EMBEDDING_DIM=768

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

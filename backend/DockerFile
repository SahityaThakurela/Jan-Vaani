# 1. Base image: Use a lightweight official Python 3.11 image
FROM python:3.11-slim

# 2. Set environment variables
# Prevent Python from writing .pyc files to disk
ENV PYTHONDONTWRITEBYTECODE=1
# Force Python stdout and stderr streams to be unbuffered
ENV PYTHONUNBUFFERED=1

# 3. Set working directory inside the container
WORKDIR /app

# 4. Copy requirements file first (for better Docker layer caching)
COPY requirements.txt /app/

# 5. Install system dependencies & Python packages
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# 6. Copy the rest of your application code into the container
COPY . /app/

# 7. Expose the port FastAPI will run on
EXPOSE 8000

# 8. Start Uvicorn server
# Change "app.main:app" if your main FastAPI instance is located elsewhere (e.g., "main:app")
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]